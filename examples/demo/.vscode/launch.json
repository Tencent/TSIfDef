{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Demo (HOK)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Build/.demorun/HOK/main.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "TSIfDef: Compile HOK demo",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/Build/.demorun/HOK/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Demo (DOMESTIC)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Build/.demorun/DOMESTIC/main.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "TSIfDef: Compile DOMESTIC demo",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/Build/.demorun/DOMESTIC/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
