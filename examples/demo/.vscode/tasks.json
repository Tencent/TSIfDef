{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TSIfDef: Precompile active demo",
      "type": "process",
      "command": "npx",
      "args": [
        "tsifdef",
        "--project", "tsconfig.json"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TSIfDef: Compile active demo",
      "type": "process",
      "command": "npx",
      "args": [
        "tsc",
        "-p", "${workspaceFolder}/.tsifdef/Output/tsconfig.json",
        "--noEmit", "false",
        "--outDir", "${workspaceFolder}/Build/.demorun/active",
        "--sourceMap", "true",
        "--inlineSources", "true"
      ],
      "dependsOn": "TSIfDef: Precompile active demo",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    }
  ]
}
