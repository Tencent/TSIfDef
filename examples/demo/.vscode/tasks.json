{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TSIfDef: Build active demo",
      "type": "process",
      "command": "npx",
      "args": [
        "tsifdef",
        "build",
        "--",
        "--noEmit", "false",
        "--outDir", "${workspaceFolder}/Build/.demorun/active",
        "--sourceMap", "true",
        "--inlineSources", "true",
        "--sourceRoot", "../../../src"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$tsc"
    },
    {
      "label": "TSIfDef: Legacy precompile active demo",
      "type": "process",
      "command": "npx",
      "args": [
        "tsifdef",
        "--project", "tsconfig.json"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TSIfDef: Legacy compile active demo",
      "type": "process",
      "command": "npx",
      "args": [
        "tsc",
        "-p", "${workspaceFolder}/.tsifdef/Output/tsconfig.json",
        "--noEmit", "false",
        "--outDir", "${workspaceFolder}/Build/.legacy/active",
        "--sourceMap", "true",
        "--inlineSources", "true",
        "--sourceRoot", "../../../src"
      ],
      "dependsOn": "TSIfDef: Legacy precompile active demo",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    }
  ]
}
