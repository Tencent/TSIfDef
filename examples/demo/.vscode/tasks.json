{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TSIfDef: Emit HOK demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../dist/cli/main.js",
        "emit",
        "--profile",
        "HOK",
        "--root",
        "${workspaceFolder}",
        "--source",
        "src"
      ],
      "problemMatcher": []
    },
    {
      "label": "TSIfDef: Compile HOK demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../node_modules/typescript/bin/tsc",
        "-p",
        "${workspaceFolder}/tsconfig.runtime.hok.json"
      ],
      "dependsOn": "TSIfDef: Emit HOK demo",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    },
    {
      "label": "TSIfDef: Emit DOMESTIC demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../dist/cli/main.js",
        "emit",
        "--profile",
        "DOMESTIC",
        "--root",
        "${workspaceFolder}",
        "--source",
        "src"
      ],
      "problemMatcher": []
    },
    {
      "label": "TSIfDef: Compile DOMESTIC demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../node_modules/typescript/bin/tsc",
        "-p",
        "${workspaceFolder}/tsconfig.runtime.domestic.json"
      ],
      "dependsOn": "TSIfDef: Emit DOMESTIC demo",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    }
  ]
}
