{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TSIfDef: Compile active demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../dist/cli/main.js",
        "tsc",
        "--profile",
        "${command:tsifdef.activeProfile}",
        "--root",
        "${workspaceFolder}",
        "--",
        "-p",
        "${workspaceFolder}/tsconfig.json",
        "--noEmit",
        "false",
        "--rootDir",
        "${workspaceFolder}/src",
        "--outDir",
        "${workspaceFolder}/Build/.demorun/${command:tsifdef.activeProfile}",
        "--sourceMap",
        "true",
        "--inlineSources",
        "true",
        "--sourceRoot",
        "../../../src"
      ],
      "problemMatcher": "$tsc"
    }
  ]
}
