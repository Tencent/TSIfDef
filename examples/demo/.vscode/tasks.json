{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TSIfDef: Emit active demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../dist/cli/main.js",
        "emit",
        "--profile",
        "${command:tsifdef.activeProfile}",
        "--root",
        "${workspaceFolder}",
        "--source",
        "src"
      ],
      "problemMatcher": []
    },
    {
      "label": "TSIfDef: Compile active demo",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/../../node_modules/typescript/bin/tsc",
        "-p",
        "${workspaceFolder}/tsconfig.runtime.${command:tsifdef.activeProfile}.json"
      ],
      "dependsOn": "TSIfDef: Emit active demo",
      "dependsOrder": "sequence",
      "problemMatcher": "$tsc"
    }
  ]
}
