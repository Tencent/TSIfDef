{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "tsifdef-tsserver",
        "profile": "HOK",
        "macrosDir": "Build/macros"
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
